              "name": "deactivate-user",
              "item": [
                {
                  "name": "Deactivate a workspace user",
                  "id": "bb3c61cf-ab9a-4fa2-8ff8-95992472444d",
                  "protocolProfileBehavior": {
                    "disableBodyPruning": true
                  },
                  "request": {
                    "method": "POST",
