                        "{{baseUrl}}"
                      ],
                      "path": [
                        "user-management",
                        "v1",
                        "deactivate-user"
                      ]
                    },
                    "description": "Removes a user from the workspace by email. The user immediately loses access,\nbut all their data (conversations, assistants, files, integrations) is preserved\nand restored if they are re-added later.\n"
