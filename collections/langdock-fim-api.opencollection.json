{
  "opencollection": "1.0.0",
  "info": {
    "name": "Langdock Agent fim API",
    "version": "3.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "fim",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Fim Completion",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.langdock.com/mistral/:region/v1/fim/completions",
            "params": [
              {
                "name": "region",
                "value": "",
                "type": "path",
                "description": "The region of the API to use."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "FIM completion."
        }
      ]
    }
  ],
  "bundled": true
}