{
  "opencollection": "1.0.0",
  "info": {
    "name": "Langdock Agent Audit Logs API",
    "version": "3.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Audit Logs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List audit logs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.langdock.com/audit-logs/:workspace_id",
            "params": [
              {
                "name": "workspace_id",
                "value": "",
                "type": "path",
                "description": "Workspace UUID. Must match the workspace associated with the API key; requests with a mismatched workspace_id are rejected with 403.\n"
              },
              {
                "name": "cursor",
                "value": "",
                "type": "query",
                "description": "Cursor for pagination (ID of last item from previous page)"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of items to return (default 50, max 50)"
              },
              {
                "name": "from",
                "value": "",
                "type": "query",
                "description": "Start of date range filter (ISO 8601)"
              },
              {
                "name": "to",
                "value": "",
                "type": "query",
                "description": "End of date range filter (ISO 8601)"
              },
              {
                "name": "entity_type",
                "value": "",
                "type": "query",
                "description": "Filter by entity type (e.g. \"User\", \"Workspace\")"
              },
              {
                "name": "actor_id",
                "value": "",
                "type": "query",
                "description": "Filter by actor UUID"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns audit log entries for a workspace with cursor-based pagination.\nRequires an API key with the `AUDIT_LOG_API` scope.\n"
        }
      ]
    }
  ],
  "bundled": true
}