{
  "opencollection": "1.0.0",
  "info": {
    "name": "Langdock Agent Attachments API",
    "version": "3.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Attachments",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Upload an attachment",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.langdock.com/attachment/v1/upload",
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "file",
                  "type": "text",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Upload a file that can be referenced in Agent conversations."
        },
        {
          "info": {
            "name": "Delete an attachment",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.langdock.com/attachment/v1/delete",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Soft-deletes an attachment by ID. The attachment must be created by the API key's creator or belong to a Knowledge base shared with the API key."
        }
      ]
    }
  ],
  "bundled": true
}