{
  "opencollection": "1.0.0",
  "info": {
    "name": "Langdock Agent API",
    "version": "3.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Agent",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Creates a chat completion with an agent (Vercel AI SDK compatible)",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.langdock.com/agent/v1/chat/completions",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a model response using Vercel AI SDK compatible UIMessage format"
        },
        {
          "info": {
            "name": "Lists the available models",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.langdock.com/agent/v1/models"
          },
          "docs": "Returns a list of models that are available for use with the API."
        }
      ]
    }
  ],
  "bundled": true
}