        {
          "id": "aa3dc440-5eca-40fb-af33-168deaa1c6da",
          "name": "Deactivate a workspace user",
          "request": {
            "name": "Deactivate a workspace user",
            "description": {
              "content": "Removes a user from the workspace by email. The user immediately loses access,\nbut all their data (conversations, assistants, files, integrations) is preserved\nand restored if they are re-added later.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "user-management",
                "v1",
                "deactivate-user"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"<email>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
