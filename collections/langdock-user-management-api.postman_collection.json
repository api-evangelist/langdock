      "item": [
        {
          "id": "9b750b22-8b34-4749-bf5d-edcb8ec09439",
          "name": "Invite users to workspace",
          "request": {
            "name": "Invite users to workspace",
            "description": {
              "content": "Sends workspace invitations to one or more users by email. Each user can optionally\nbe assigned a specific role. If no role is specified, the default role `member` is used.\n\nUsers who are already members of the workspace are silently skipped. Users with pending\njoin requests are automatically approved. Invalid email addresses are reported in the\nresponse but do not cause the entire request to fail.\n\nAn invitation email is sent to each successfully invited user. If the workspace does not\nhave SAML enabled, the email includes a magic link for passwordless sign-in.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "user-management",
                "v1",
                "invite"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"users\": [\n    {\n      \"email\": \"<email>\",\n      \"role\": \"<string>\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
