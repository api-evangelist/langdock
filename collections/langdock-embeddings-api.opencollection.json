{
  "opencollection": "1.0.0",
  "info": {
    "name": "Langdock Agent Embeddings API",
    "version": "3.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Embeddings",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Creates embeddings for the given input text.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.langdock.com/openai/:region/v1/embeddings",
            "params": [
              {
                "name": "region",
                "value": "",
                "type": "path",
                "description": "The region of the API to use."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Creates embeddings for the given input text."
        }
      ]
    }
  ],
  "bundled": true
}