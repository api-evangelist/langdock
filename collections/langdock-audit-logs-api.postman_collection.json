          "name": "List audit logs",
          "request": {
            "name": "List audit logs",
            "description": {
              "content": "Returns audit log entries for a workspace with cursor-based pagination.\nRequires an API key with the `AUDIT_LOG_API` scope.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "audit-logs",
                ":workspace_id"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "cursor",
                  "value": "<uuid>",
                  "description": "Cursor for pagination (ID of last item from previous page)"
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "50",
                  "description": "Maximum number of items to return (default 50, max 50)"
                },
                {
                  "disabled": false,
                  "key": "from",
                  "value": "<dateTime>",
                  "description": "Start of date range filter (ISO 8601)"
                },
                {
                  "disabled": false,
                  "key": "to",
                  "value": "<dateTime>",
                  "description": "End of date range filter (ISO 8601)"
                },
                {
                  "disabled": false,
                  "key": "entity_type",
                  "value": "<string>",
                  "description": "Filter by entity type (e.g. \"User\", \"Workspace\")"
                },
                {
                  "disabled": false,
                  "key": "actor_id",
                  "value": "<uuid>",
                  "description": "Filter by actor UUID"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "workspace_id",
                  "description": "(Required) Workspace UUID. Must match the workspace associated with the API key; requests with a mismatched workspace_id are rejected with 403.\n"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
          },
