{
  "opencollection": "1.0.0",
  "info": {
    "name": "Langdock Agent Knowledge API",
    "version": "3.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Knowledge",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Search through all files in data folders shared with the API Key",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.langdock.com/knowledge/search",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Search through all files in data folders shared with the API Key"
        },
        {
          "info": {
            "name": "Upload a file to a knowledge folder",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.langdock.com/knowledge/:folderId",
            "params": [
              {
                "name": "folderId",
                "value": "",
                "type": "path",
                "description": "The ID of the knowledge folder"
              }
            ],
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "file",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "url",
                  "type": "text",
                  "value": ""
                }
              ]
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Upload a file to a knowledge folder"
        },
        {
          "info": {
            "name": "Update a file in a knowledge folder",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.langdock.com/knowledge/:folderId",
            "params": [
              {
                "name": "folderId",
                "value": "",
                "type": "path",
                "description": "The ID of the knowledge folder"
              }
            ],
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "file",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "url",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "attachmentId",
                  "type": "text",
                  "value": ""
                }
              ]
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Update a file in a knowledge folder"
        },
        {
          "info": {
            "name": "Retrieve files from a knowledge folder",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.langdock.com/knowledge/:folderId/list",
            "params": [
              {
                "name": "folderId",
                "value": "",
                "type": "path",
                "description": "The ID of the knowledge folder"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieve files from a knowledge folder"
        },
        {
          "info": {
            "name": "Delete a file from a knowledge folder",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.langdock.com/knowledge/:folderId/:attachmentId",
            "params": [
              {
                "name": "folderId",
                "value": "",
                "type": "path",
                "description": "The ID of the knowledge folder"
              },
              {
                "name": "attachmentId",
                "value": "",
                "type": "path",
                "description": "The ID of the attachment to delete"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Delete a file from a knowledge folder"
        }
      ]
    }
  ],
  "bundled": true
}